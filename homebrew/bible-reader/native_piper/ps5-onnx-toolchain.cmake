# Experimental: FreeBSD ABI from the PS5 homebrew SDK.
# The official FreeBSD port is a starting point, not proof of PS5 support.
set(CMAKE_SYSTEM_NAME FreeBSD)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_C_COMPILER clang-18)
set(CMAKE_CXX_COMPILER clang++-18)
set(CMAKE_C_COMPILER_TARGET x86_64-sie-ps5)
set(CMAKE_CXX_COMPILER_TARGET x86_64-sie-ps5)
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_AR llvm-ar-18)
set(CMAKE_RANLIB llvm-ranlib-18)
set(CMAKE_NM llvm-nm-18)
if(NOT DEFINED PS5_HOME)
  if(DEFINED ENV{PS5_HOME})
    set(PS5_HOME "$ENV{PS5_HOME}" CACHE PATH "PS5 SDK root")
  else()
    message(FATAL_ERROR "Set PS5_HOME to the SDK root for all try_compile sub-builds")
  endif()
endif()
set(CMAKE_SYSROOT "${PS5_HOME}")
set(CMAKE_C_FLAGS_INIT "-fvisibility-nodllstorageclass=default -isysroot ${PS5_HOME} -isystem ${PS5_HOME}/target/include/c++/v1 -isystem ${PS5_HOME}/target/include -fno-stack-protector -fno-plt -femulated-tls -fno-omit-frame-pointer")
set(CMAKE_CXX_FLAGS_INIT "-fvisibility-nodllstorageclass=default -isysroot ${PS5_HOME} -isystem ${PS5_HOME}/target/include/c++/v1 -isystem ${PS5_HOME}/target/include -fno-stack-protector -fno-plt -femulated-tls -fno-omit-frame-pointer -fexceptions -Wno-error=unused-variable -DBIBLE_ONNX_PS5=1")
set(CMAKE_FIND_ROOT_PATH "${PS5_HOME}")
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
