# CMake PS5 cross-compile probe; no playable zplayer claim.
cmake_minimum_required(VERSION 3.29)
set(CMAKE_SYSTEM_NAME FreeBSD)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
if(NOT DEFINED ENV{PS5_PAYLOAD_SDK} OR
   NOT EXISTS "$ENV{PS5_PAYLOAD_SDK}/target/include")
  message(FATAL_ERROR "PS5_PAYLOAD_SDK missing")
endif()
if(NOT DEFINED ENV{PS5_DEVBRIDGE_TOOL} OR
   NOT EXISTS "$ENV{PS5_DEVBRIDGE_TOOL}")
  message(FATAL_ERROR "PS5_DEVBRIDGE_TOOL missing")
endif()
set(CMAKE_C_COMPILER "$ENV{PS5_DEVBRIDGE_TOOL}" CACHE FILEPATH "" FORCE)
set(CMAKE_CXX_COMPILER "$ENV{PS5_DEVBRIDGE_TOOL}" CACHE FILEPATH "" FORCE)
set(CMAKE_C_COMPILER_TARGET x86_64-sie-ps5)
set(CMAKE_CXX_COMPILER_TARGET x86_64-sie-ps5)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_SYSROOT "$ENV{PS5_PAYLOAD_SDK}")
set(CMAKE_FIND_ROOT_PATH "$ENV{PS5_PAYLOAD_SDK}")
# SDK Sce imports and real libc/pthread libraries are in target/lib,
# not in the sysroot's normal FreeBSD /usr/lib directory. The native
# PS5-DevBridge linker uses these SDK libraries explicitly.
set(CMAKE_EXE_LINKER_FLAGS_INIT "-L$ENV{PS5_PAYLOAD_SDK}/target/lib")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-L$ENV{PS5_PAYLOAD_SDK}/target/lib")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "-L$ENV{PS5_PAYLOAD_SDK}/target/lib")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_C_STANDARD 11)
set(CMAKE_CXX_STANDARD 20)
# Never fake WIN32/EMSCRIPTEN to bypass real PS5 platform dependencies.
